# Base URL of the TweetMate API (no trailing slash)
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID used by @react-oauth/google.
# Defaults to the project's existing client ID, so Google sign-in works with no
# configuration. Set this to use your own. (Client IDs are public — they ship in
# the JS bundle. The client *secret* is never used by this app.)
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public origin used when building shareable post links.
# Defaults to the browser's own origin when unset.
# VITE_SHARE_BASE_URL=https://souvik-tweetmate-91.netlify.app
