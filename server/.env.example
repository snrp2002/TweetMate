# Port the API listens on (optional, defaults to 5000)
PORT=5000

# MongoDB connection string
DATABASE_URL=mongodb://127.0.0.1:27017/tweetmate

# Secret used to sign and verify JWTs (required)
JWT_SECRET=replace-me-with-a-long-random-string

# Google OAuth client ID that access tokens must be issued for.
# Defaults to the project's existing client ID. Must match the client's
# VITE_GOOGLE_CLIENT_ID, or Google sign-in will be rejected.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of allowed browser origins.
# Leave unset to allow all origins (the previous behaviour).
# CORS_ORIGINS=http://localhost:5173,https://souvik-tweetmate-91.netlify.app
