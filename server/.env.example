# Port the API listens on (optional, defaults to 5000)
PORT=5000

# MongoDB connection string
DATABASE_URL=mongodb://127.0.0.1:27017/tweetmate

# Secret used to sign and verify JWTs (required)
JWT_SECRET=replace-me-with-a-long-random-string

# Google OAuth client ID that access tokens must be issued for.
# Defaults to the project's existing client ID. Must match the client's
# VITE_GOOGLE_CLIENT_ID, or Google sign-in will be rejected.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of allowed browser origins.
# Leave unset to allow all origins (the previous behaviour).
# CORS_ORIGINS=http://localhost:5173,https://souvik-tweetmate-91.netlify.app

# --- Cloudinary (optional) -------------------------------------------------
# When unset, images are stored inline as base64 exactly as before.
# Find these on the Cloudinary dashboard under "API Keys".
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=...

# --- Password reset email (optional) ---------------------------------------
# Without these, /auth/forgot returns 503 and the reset flow stays disabled.
# Free tier: https://resend.com (3,000 emails/month)
# RESEND_API_KEY=re_...
# MAIL_FROM=TweetMate <noreply@yourdomain.com>

# Where reset links point. Must be the deployed client origin.
# CLIENT_URL=https://souvik-tweetmate-91.netlify.app
