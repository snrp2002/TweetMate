{
  "name": "tweetmate-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memory": "tsx scripts/dev-memory.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/smoke.ts",
    "migrate:images": "tsx scripts/migrate-images.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snrp2002/TweetMate.git"
  },
  "bugs": {
    "url": "https://github.com/snrp2002/TweetMate/issues"
  },
  "homepage": "https://github.com/snrp2002/TweetMate#readme",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "mongodb-memory-server": "^11.0.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
